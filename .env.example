# docker-compose.yml / docker-compose.prod.yml から使用される設定。
# `.env`にコピーして実際の値を設定すること。実際の`.env`はコミットしないこと。

# --- PostgreSQL（コンテナの認証情報） ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# 統合テスト(tests/integration/、`pytest -m integration`)専用のデータベース名。
# 開発用DB(POSTGRES_DB)とは別にする ── 同じDBを使うとconftest.pyのcreate_all/drop_allが
# 開発用データ・スキーマを消してしまう(devex-api/CLAUDE.md「テストの分離」節参照)。
POSTGRES_TEST_DB=app_test

# --- ホストに公開するポート（開発用。docker-compose.prod.ymlはこれらのポートを一切公開しない） ---
BACKEND_PORT=8000
NGINX_PORT=80
# 統合テスト（tests/integration/、`pytest -m integration`）をホスト側から実行するために公開する。
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- backendアプリケーションの設定（backendコンテナにそのまま渡される） ---
# ホスト名"postgres"/"redis"はdocker-composeのネットワーク経由で解決される。
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/app
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

GOOGLE_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 設計レビュー(superuser が設定でオンにしたときだけ呼ぶ。未設定ならレビューは失敗し、自己診断に切り替わる)
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-sonnet-5-5
REVIEW_RATE_LIMIT_PER_DAY=20

# マイページで登録する API キーを暗号化する Fernet の鍵(カンマ区切りで複数。先頭で暗号化し、すべてで復号)。
# 作り方: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 鍵を回すときは新しい鍵を先頭に足し、古い鍵を後ろに残す。空ならキーの登録だけが使えない(503)
ENCRYPTION_KEY=

# Google でのログイン(Google Cloud の OAuth クライアント ID。ID トークンの aud を確かめる)。
# 空なら Google のログインだけが使えない(503)。メールとパスワードのログインは続く
GOOGLE_CLIENT_ID=
# E2E 専用。true なら偽の credential(fake:<sub>:<email>)を受け付ける。本番では起動時に拒否される
E2E_FAKE_GOOGLE=false

# チャットメッセージ送信のレート制限（1ユーザーあたりの上限回数）
CHAT_RATE_LIMIT_PER_HOUR=20
CHAT_RATE_LIMIT_PER_DAY=100

# 認証エンドポイントのレート制限（総当たり・大量登録の対策。単位時間あたりの上限回数）
LOGIN_RATE_LIMIT_PER_IP_PER_HOUR=30
LOGIN_RATE_LIMIT_PER_EMAIL_PER_HOUR=20
REGISTER_RATE_LIMIT_PER_IP_PER_HOUR=10
GOOGLE_RATE_LIMIT_PER_IP_PER_HOUR=30

# リクエストボディの上限（バイト）
MAX_REQUEST_BODY_BYTES=2000000

ENVIRONMENT=development
DEBUG=true
